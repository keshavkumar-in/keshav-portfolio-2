# Contentful — the project catalogue.
# The client is only ever constructed on the server; the non-prefixed names
# below are read as a fallback and are the safer choice for new deployments.
NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=

# Contact form. Server-only — do NOT prefix these with NEXT_PUBLIC_.
#
# 1. Create a key at https://resend.com/api-keys  ->  RESEND_API_KEY
# 2. Set CONTACT_TO_EMAIL to the inbox that should receive enquiries.
# 3. Leave CONTACT_FROM_EMAIL unset to start. It defaults to Resend's shared
#    sender, which needs no DNS but can only deliver to the address your
#    Resend account is registered with.
# 4. Once keshavkumar.in is verified at https://resend.com/domains, set
#    CONTACT_FROM_EMAIL="Portfolio <noreply@keshavkumar.in>".
#
# Verify with:  node --env-file=.env.local scripts/check-contact.mjs
# Then send a real test:              ... scripts/check-contact.mjs --send
#
# With none of these set the form still renders and fails gracefully, showing
# the mailto fallback instead of breaking.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
